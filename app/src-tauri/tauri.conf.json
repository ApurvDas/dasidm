{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DasIDM",
  "version": "0.4.0",
  "identifier": "dev.dasidm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "publisher": "Apurv Das",
    "copyright": "Copyright 2026 Apurv Das. Apache License 2.0.",
    "license": "Apache-2.0",
    "homepage": "https://github.com/ApurvDas/dasidm",
    "shortDescription": "Fast download manager for Windows",
    "longDescription": "Download files over many connections, video and music from websites, and torrents; with a Firefox add-on that hands your downloads to DasIDM."
  }
}
