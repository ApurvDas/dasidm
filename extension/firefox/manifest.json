{
  "manifest_version": 3,
  "name": "DasIDM – Download Manager",
  "version": "0.4.0",
  "description": "Sends the files you download in Firefox to the free DasIDM download manager for Windows (needs DasIDM installed). Not affiliated with Internet Download Manager.",
  "homepage_url": "https://github.com/ApurvDas/dasidm",
  "browser_specific_settings": {
    "gecko": {
      "id": "dasidm@dasidm.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["downloads", "webRequest", "webRequestBlocking", "nativeMessaging", "cookies", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["rules.js", "background.js"] },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }],
  "action": {
    "default_title": "DasIDM",
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/32.png", "64": "icons/64.png" }
  },
  "icons": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" }
}
